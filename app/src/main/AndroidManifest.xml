<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Required from API 33 to show the sync-in-progress notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Required to run SyncNotificationService as a foreground service, so its notification's
         lifecycle is tied to the service instead of surviving a killed process; see
         SyncNotificationService.kt for why a plain posted notification wasn't good enough. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MySailingLogbook">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <!-- configChanges above: MainActivity builds its whole UI programmatically (one
                 LinearLayout, no separate portrait/landscape resources) and drives it entirely
                 from a long-lived background Thread plus SyncController callbacks captured
                 against one specific Activity instance (see runSync()/syncFromW2k2()). The
                 default destroy-and-recreate-on-rotation behavior orphaned that Thread's updates
                 onto a dead Activity instance mid-sync, found in practice: a real, reproducible
                 bug, not just the already-patched "stuck on a stale placeholder text" case (see
                 onCreate()'s own SyncState.inProgress branch and autoStartSyncWithSettingsRetry()'s
                 doc comment for two earlier, narrower patches of the same underlying issue reached
                 via different paths). Rotating mid-sync silently froze the whole screen, with no
                 further progress, log lines, or even the eventual success/failure result ever
                 reaching the new (visible) Activity instance, since every one of those callbacks
                 was still only updating the orphaned old instance's now-invisible views. This asks
                 Android to keep reusing the same Activity instance across a rotation instead,
                 which fixes the root cause directly rather than adding a third narrow patch. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="Instellingen" />

        <service
            android:name=".SyncNotificationService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>