<!-- Standard Material Icons "file_upload" glyph (24dp grid): an arrow pointing up out of a
     horizontal tray, the same icon Material Design itself uses for "upload" specifically
     (distinct from "cloud_upload", which adds a cloud shape, and "publish", which encloses the
     arrow in a full box). fillColor here is just a placeholder: MainActivity.iconButton() applies
     compoundDrawableTintList at runtime instead, matching the button's own resolved text color,
     so this follows the app's DayNight theme automatically without needing a light/night variant
     of its own. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FF000000"
        android:pathData="M9,16h6v-6h4L12,3L5,10h4v6zM5,18h14v2L5,20z"/>
</vector>
